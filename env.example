# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8001

# Reverse proxies whose X-Forwarded-For header uvicorn may trust, comma
# separated, or "*" for every peer. In production set this to the address of
# the Nginx host in front of the service (VM1), not to "*", otherwise a client
# that reaches the port directly can forge its own source address.
# The login rate limiter keys on the resulting client address, so leaving the
# default here makes every user share one bucket behind a proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Security. Comma separated lists; they are parsed into lists and passed to
# TrustedHostMiddleware and CORSMiddleware. Both are REQUIRED in production
# and must name real values: an empty list and "*" both stop the server.
# A wildcard ALLOWED_HOSTS accepts any Host header and a wildcard
# ALLOWED_ORIGINS lets any site call this API from a browser, so neither is a
# valid production setting. Bifrost enforces the same rule.
#
# Recommended production values:
#   ALLOWED_HOSTS=api.bnbong.com,auth-server,localhost
#   ALLOWED_ORIGINS=https://admin.bnbong.com,https://bnbong.com
#
# ALLOWED_HOSTS needs more than the public name because TrustedHostMiddleware
# checks the Host header of every request, including internal ones:
#   - api.bnbong.com : requests arriving through VM1 Nginx
#   - auth-server    : Bifrost calls this service by its compose service name
#   - localhost      : the container HEALTHCHECK curls http://localhost:8001
# ALLOWED_ORIGINS only needs the browser origins of the admin and public sites.
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

# JWT settings.
# In production the server refuses to start when JWT_SECRET_KEY is empty,
# shorter than 32 characters or still contains an example marker.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-force mitigation for POST /auth/token only. In-process and per worker,
# so it is a mitigation rather than a quota. /health and /metrics are excluded.
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Database. Required in production; there is no fallback there.
DATABASE_URL=postgresql://bnbong:password@postgres:5432/bngdrasil

# Initial administrator creation (CLI only, never committed):
#   BIDAR_ADMIN_PASSWORD='...' python -m src.cli create-admin \
#     --username admin --email admin@example.com
